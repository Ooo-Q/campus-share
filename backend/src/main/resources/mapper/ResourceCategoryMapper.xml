<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campusshare.mapper.ResourceCategoryMapper">

    <resultMap id="CategoryResult" type="com.campusshare.entity.ResourceCategory">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findAll" resultMap="CategoryResult">
        SELECT * FROM resource_category ORDER BY sort_order ASC, created_at DESC
    </select>

    <select id="findById" resultMap="CategoryResult">
        SELECT * FROM resource_category WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.campusshare.entity.ResourceCategory" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO resource_category(name, sort_order, created_at, updated_at)
        VALUES (#{name}, #{sortOrder}, NOW(), NOW())
    </insert>

    <update id="update" parameterType="com.campusshare.entity.ResourceCategory">
        UPDATE resource_category
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            updated_at = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM resource_category WHERE id = #{id}
    </delete>
</mapper>

